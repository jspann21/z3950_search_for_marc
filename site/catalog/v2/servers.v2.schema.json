{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jspann21.github.io/z3950_search_for_marc/catalog/v2/servers.schema.json",
  "title": "Z39.50 MARC Search server catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "published_at", "servers"],
  "properties": {
    "schema_version": { "const": 2 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "host", "port", "database", "country_code",
          "location_group", "record_syntax", "query_charset", "marc_charset",
          "priority", "status", "last_verified_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "host": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "database": { "type": "string", "minLength": 1 },
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "location_group": { "enum": ["USA", "Worldwide"] },
          "record_syntax": { "type": "string", "minLength": 1 },
          "query_charset": { "type": "string", "minLength": 1 },
          "marc_charset": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "status": { "enum": ["active", "quarantined", "retired"] },
          "last_verified_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}

